{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zdoma",
	"main": "worker.mjs",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// T-39: daily check-in reminders (worker.mjs → /api/cron/opomniki).
	"triggers": {
		"crons": ["*/15 * * * *"]
	}
	// NEXT_PUBLIC_* values are inlined at build time from .env.local.
	// Server-only secrets are Worker secrets, never in this file:
	//   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY | VAPID_PRIVATE_KEY | CRON_SECRET
}
