# Supabase (shared zDoma project). Get the values with the CLI command in AGENTS.md §9.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (family registration, QR accounts, seeding). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Seed (npm run seed): password for seeded staff and family accounts.
SEED_PASSWORD=
# Web Push (T-39). Generate with: npx @pushforge/builder vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only: private key as JWK JSON, and the secret the cron trigger sends.
VAPID_PRIVATE_KEY=
CRON_SECRET=
